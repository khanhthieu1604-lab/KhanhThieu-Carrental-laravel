# =================================================================
# Thiuu Rental Elite - Cấu hình môi trường (Environment Template)
# =================================================================
# ⚠️ CẢNH BÁO BẢO MẬT: TUYỆT ĐỐI không commit file .env thật vào Git!
# Đây là file mẫu. Copy sang .env và điền giá trị thực của bạn.
# =================================================================

# --- ỨNG DỤNG (APPLICATION) ---
APP_NAME="Thiuu Rental Elite"
APP_ENV=local
APP_KEY=  # Tạo bằng lệnh: php artisan key:generate
APP_DEBUG=false  # QUAN TRỌNG: Đặt false khi deploy production!
APP_URL=http://localhost:8000

# --- LOGGING ---
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug  # Dùng 'error' hoặc 'warning' trong production

# --- CẤU HÌNH DATABASE ---
# SQLite (Development):
DB_CONNECTION=sqlite

# MySQL (Production - khuyến nghị):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=thiuu_rental
# DB_USERNAME=your_database_user
# DB_PASSWORD=your_secure_database_password

# --- CẤU HÌNH GOONG.IO (Luxury Maps) ---
# ⚠️ QUAN TRỌNG: Thay thế bằng API key riêng của bạn!
# Đăng ký tại: https://account.goong.io/
GOONG_API_KEY=your_goong_autocomplete_api_key_here
GOONG_MAP_KEY=your_goong_map_js_api_key_here

# --- CẤU HÌNH EMAIL ---
# Development (Mailhog - Docker):
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@thiuurental.com"
MAIL_FROM_NAME="Thiuu Rental Elite Admin"

# Production (Gmail SMTP - KHÔNG khuyến nghị cho production thật):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_gmail_app_password  # ⚠️ Dùng App Password, không phải mật khẩu Gmail!
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=your_email@gmail.com
# MAIL_FROM_NAME="Thiuu Rental Elite"

# Production (Transactional Email Service - Khuyến nghị):
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=your_postmark_server_token
# MAIL_FROM_ADDRESS="noreply@yourdomain.com"
# MAIL_FROM_NAME"${APP_NAME}"

# --- CÁC CẤU HÌNH KHÁC ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync  # Dùng 'redis' hoặc 'database' trong production
SESSION_DRIVER=file
SESSION_LIFETIME=30  # Phút - giảm xuống 30 để bảo mật hơn

# --- REDIS (Production) ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# --- GEMINI AI (Chatbot) ---
# ⚠️ QUAN TRỌNG: Lấy API key tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_ai_api_key_here

# --- TELEGRAM BOT (Notifications - Tùy chọn) ---
# Tạo bot tại: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- VNPAY PAYMENT GATEWAY ---
# ⚠️ QUAN TRỌNG: Liên hệ VNPay để lấy thông tin merchant
# Sandbox: https://sandbox.vnpayment.vn/
# Production: https://vnpay.vn/
VNPAY_TMN_CODE=your_vnpay_terminal_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret_key
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/payment/vnpay/return"

# Production VNPay:
# VNPAY_URL=https://pay.vnpay.vn/vpcpay.html

# --- AWS S3 (Nếu dùng cloud storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- LIÊN KẾT DỰ ÁN KHÁC ---
# URL của KThiuu_Hotel (nếu có tích hợp cross-project)
KTHIUU_HOTEL_URL=http://localhost:8001

# --- VITE (Frontend Build) ---
VITE_APP_NAME="${APP_NAME}"
